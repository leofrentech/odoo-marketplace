<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="easy_access_role_category" model="ir.module.category">
        <field name="name">Easy Access Rule</field>
        <field name="sequence">7</field>
    </record>

    <record id="access_management_group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="easy_access_role_category" />
        <field name="comment">Manages the Easy Access rules, including the Model Access granting rights beyond the users' groups.</field>
        <field name="users"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>
</odoo>
