<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="Chatter" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div" position="attributes">
            <attribute name="t-if">state.thread &amp;&amp; !state.hideChatter</attribute>
        </xpath>
        <!-- Send Message -->
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="attributes">
            <attribute name="t-if">props.hasMessageList &amp;&amp; !state.hideSendMessage</attribute>
        </xpath>
        <!-- Log Note -->
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="attributes">
            <attribute name="t-if">props.hasMessageList &amp;&amp; !state.hideLogNote</attribute>
        </xpath>
        <!-- Activity -->
        <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="attributes">
            <attribute name="t-if">props.hasActivities &amp;&amp; !state.hideActivity</attribute>
        </xpath>
        <!-- Followers -->
        <xpath expr="//Dropdown[contains(@class, 'o-mail-Followers')]" position="attributes">
            <attribute name="t-if">props.hasFollowers &amp;&amp; !state.hideFollowers</attribute>
        </xpath>
        <xpath expr="//button[@t-ref='unfollow']" position="attributes">
            <attribute name="t-if">props.hasFollowers &amp;&amp; state.thread.selfFollower &amp;&amp; !state.hideFollowers</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-follow')]" position="attributes">
            <attribute name="t-if">!state.thread.selfFollower &amp;&amp; !state.hideFollowers</attribute>
        </xpath>
        <!-- Search Message -->
        <xpath expr="//button[@title='Search Messages']" position="attributes">
            <attribute name="t-if">!state.hideSearchMessage</attribute>
        </xpath>
    </t>

    <t t-name="Chatter.attachFiles" t-inherit="mail.Chatter.attachFiles" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-if">!state.hideAttachments</attribute>
        </xpath>
    </t>
</templates>
