<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="Chatter" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter')]" position="attributes">
            <attribute name="t-if">this.state.thread and !this.state.hideChatter</attribute>
        </xpath>
        <!-- Send Message -->
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="attributes">
            <attribute name="t-if">!this.state.hideSendMessage</attribute>
        </xpath>
        <!-- Log Note -->
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="attributes">
            <attribute name="t-if">!this.state.hideLogNote</attribute>
        </xpath>
        <!-- Activity -->
        <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="attributes">
            <attribute name="t-if">this.webChatterProps.has_activities and !this.state.hideActivity</attribute>
        </xpath>
        <!-- Followers -->
        <xpath expr="//div[hasclass('o-mail-Followers')]" position="attributes">
            <attribute name="t-if">!this.state.hideFollowers</attribute>
        </xpath>
        <!-- Message search -->
        <xpath expr="//button[@title='Search Messages']" position="attributes">
            <attribute name="t-if">!this.state.hideSearchMessage</attribute>
        </xpath>
    </t>

    <t t-name="Chatter.attachFiles" t-inherit="mail.Chatter.attachFiles" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-if">!this.state.hideAttachments</attribute>
        </xpath>
    </t>
</templates>
