<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show the customer designs under each line of the quotation / order PDF.
         The confirmation email attaches this PDF, so customers see them too. -->
    <template id="report_saleorder_document_personalization"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//td[@name='td_product_name']//div[hasclass('o_product_name_cell')]" position="inside">
            <t t-set="lf_designs" t-value="line.sudo().personalization_ids.filtered('is_customized')"/>
            <div t-if="lf_designs" class="mt-2">
                <t t-foreach="lf_designs" t-as="design">
                    <div t-if="design.product_image"
                         style="display: inline-block; margin: 0 8px 4px 0; text-align: center; vertical-align: top;">
                        <img t-att-src="image_data_uri(design.product_image)"
                             style="width: 90px; height: 90px; object-fit: contain; border: 1px solid #dee2e6;"/>
                        <div style="font-size: 0.8em; color: #6c757d;" t-out="design.design_type"/>
                    </div>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
