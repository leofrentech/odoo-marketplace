<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Designs follow the visibility of their sales order -->
    <record id="personalization_rule_personal" model="ir.rule">
        <field name="name">Personal Order Designs</field>
        <field name="model_id" ref="model_sale_order_line_personalization"/>
        <field name="domain_force">['|', ('salesman_id', '=', user.id), ('salesman_id', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="personalization_rule_all" model="ir.rule">
        <field name="name">All Order Designs</field>
        <field name="model_id" ref="model_sale_order_line_personalization"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="personalization_rule_company" model="ir.rule">
        <field name="name">Order Designs: multi-company</field>
        <field name="model_id" ref="model_sale_order_line_personalization"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="design_set_rule_company" model="ir.rule">
        <field name="name">Design Templates: multi-company</field>
        <field name="model_id" ref="model_product_design_set"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
