<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_design_config_view_list" model="ir.ui.view">
        <field name="name">product.design.config.list</field>
        <field name="model">product.design.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="design_image" widget="image" options="{'size': [40, 40]}" string=" "/>
                <field name="design_type"/>
                <field name="product_variant_id" optional="hide"/>
                <field name="is_restricted_area" optional="show"/>
                <field name="is_required" optional="show"/>
                <field name="price_extra" optional="show"/>
            </list>
        </field>
    </record>

    <record id="product_design_config_view_form" model="ir.ui.view">
        <field name="name">product.design.config.form</field>
        <field name="model">product.design.config</field>
        <field name="arch" type="xml">
            <form string="Personalization Area">
                <sheet>
                    <field name="design_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="design_type"/>
                        <h1><field name="design_type" placeholder="e.g. Front"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_tmpl_id" invisible="1"/>
                            <field name="design_set_id" invisible="1"/>
                            <field name="product_variant_id" invisible="not product_tmpl_id"
                                   options="{'no_create': True}"/>
                            <field name="is_required"/>
                            <field name="price_extra"/>
                        </group>
                        <group>
                            <field name="is_restricted_area"/>
                        </group>
                    </group>
                    <div invisible="not is_restricted_area">
                        <separator string="Printable Zone"/>
                        <field name="design_image" widget="design_area_widget" nolabel="1"/>
                        <group string="Zone Coordinates (800 x 800 editor)">
                            <group>
                                <field name="bound_x"/>
                                <field name="bound_y"/>
                            </group>
                            <group>
                                <field name="bound_width"/>
                                <field name="bound_height"/>
                            </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
