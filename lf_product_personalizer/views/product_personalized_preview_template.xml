<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="personalization_modals" inherit_id="lf_product_personalizer.product_personalization_page"
              name="Personalization Modals">
        <xpath expr="//div[@id='wrap']" position="inside">
            <!-- Preview -->
            <div class="modal fade o_lf_preview_modal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-md-down">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Your design</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                        </div>
                        <div class="modal-body">
                            <div class="o_lf_preview_grid row g-3"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep editing</button>
                            <button type="button" class="btn btn-primary o_lf_add_to_cart" data-bs-dismiss="modal">
                                <i class="oi me-1" data-icon="shopping_cart" role="img" aria-hidden="true"/>
                                <t t-if="revision">Send for review</t>
                                <t t-else="">Add to cart</t>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Text prompt (save design / save template) -->
            <div class="modal fade o_lf_name_modal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <form class="modal-content o_lf_name_form">
                        <div class="modal-header">
                            <h5 class="modal-title o_lf_name_title">Name your design</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                        </div>
                        <div class="modal-body">
                            <input type="text" class="form-control o_lf_name_input" maxlength="100"
                                   required="required" aria-label="Name"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
