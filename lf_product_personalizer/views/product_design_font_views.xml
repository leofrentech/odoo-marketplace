<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_design_font_view_list" model="ir.ui.view">
        <field name="name">product.design.font.list</field>
        <field name="model">product.design.font</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="family"/>
                <field name="source"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="product_design_font_view_form" model="ir.ui.view">
        <field name="name">product.design.font.form</field>
        <field name="model">product.design.font</field>
        <field name="arch" type="xml">
            <form string="Font">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="family"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="font_file" filename="font_filename"
                                   invisible="source != 'upload'" required="source == 'upload'"/>
                            <field name="font_filename" invisible="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="source != 'google'">
                        Google Fonts are downloaded by visitors' browsers from
                        fonts.googleapis.com. Upload the font file instead if you
                        prefer not to share visitor data with Google.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_design_font_view_search" model="ir.ui.view">
        <field name="name">product.design.font.search</field>
        <field name="model">product.design.font</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="product_design_font_action" model="ir.actions.act_window">
        <field name="name">Fonts</field>
        <field name="res_model">product.design.font</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
