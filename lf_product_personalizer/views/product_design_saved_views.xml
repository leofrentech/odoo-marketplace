<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_design_saved_view_list" model="ir.ui.view">
        <field name="name">product.design.saved.list</field>
        <field name="model">product.design.saved</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="product_id" optional="hide"/>
                <field name="write_date" string="Last Update"/>
            </list>
        </field>
    </record>

    <record id="product_design_saved_view_form" model="ir.ui.view">
        <field name="name">product.design.saved.form</field>
        <field name="model">product.design.saved</field>
        <field name="arch" type="xml">
            <form string="Saved Design" create="0">
                <sheet>
                    <field name="preview_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="partner_id"/>
                        <field name="product_tmpl_id"/>
                        <field name="product_id"/>
                        <field name="website_id" groups="website.group_multi_website"/>
                    </group>
                    <field name="design_json" groups="base.group_no_one"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_design_saved_action" model="ir.actions.act_window">
        <field name="name">Saved Customer Designs</field>
        <field name="res_model">product.design.saved</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
