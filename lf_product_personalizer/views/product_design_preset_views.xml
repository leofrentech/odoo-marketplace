<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_design_preset_view_kanban" model="ir.ui.view">
        <field name="name">product.design.preset.kanban</field>
        <field name="model">product.design.preset</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="preview_image" widget="image" class="text-center"
                               options="{'size': [0, 160], 'img_class': 'object-fit-contain'}"/>
                        <field name="name" class="fw-bold"/>
                        <field name="product_tmpl_id" class="text-muted"/>
                        <field name="design_set_id" class="text-muted"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="product_design_preset_view_list" model="ir.ui.view">
        <field name="name">product.design.preset.list</field>
        <field name="model">product.design.preset</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="design_set_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="product_design_preset_view_form" model="ir.ui.view">
        <field name="name">product.design.preset.form</field>
        <field name="model">product.design.preset</field>
        <field name="arch" type="xml">
            <form string="Ready-made Design" create="0">
                <sheet>
                    <field name="preview_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="product_tmpl_id"/>
                        <field name="design_set_id"/>
                        <field name="active"/>
                    </group>
                    <field name="design_json" groups="base.group_no_one"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_design_preset_action" model="ir.actions.act_window">
        <field name="name">Ready-made Designs</field>
        <field name="res_model">product.design.preset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No ready-made design yet</p>
            <p>Open a personalizable product on your website, create a design and
               click <b>Save as template</b>. Customers can then start from it.</p>
        </field>
    </record>
</odoo>
