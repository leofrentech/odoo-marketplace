<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_design_set_view_list" model="ir.ui.view">
        <field name="name">product.design.set.list</field>
        <field name="model">product.design.set</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="area_ids" widget="many2many_tags" string="Areas"/>
                <field name="product_count" string="Products"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="product_design_set_view_form" model="ir.ui.view">
        <field name="name">product.design.set.form</field>
        <field name="model">product.design.set</field>
        <field name="arch" type="xml">
            <form string="Design Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button"
                                icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. T-shirt (front / back)"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <div class="text-muted mb-2">
                        Products using this template share these areas. Areas set
                        directly on a product replace the template ones.
                    </div>
                    <field name="area_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_design_set_action" model="ir.actions.act_window">
        <field name="name">Design Templates</field>
        <field name="res_model">product.design.set</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a design template</p>
            <p>Define the areas once (e.g. Front, Back) and reuse them on all
               similar products.</p>
        </field>
    </record>
</odoo>
