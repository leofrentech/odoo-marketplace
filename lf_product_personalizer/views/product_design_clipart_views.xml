<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_design_clipart_view_kanban" model="ir.ui.view">
        <field name="name">product.design.clipart.kanban</field>
        <field name="model">product.design.clipart</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="me-2">
                            <field name="image" widget="image" options="{'size': [64, 64]}"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold"/>
                            <field name="category_id" class="text-muted"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="product_design_clipart_view_list" model="ir.ui.view">
        <field name="name">product.design.clipart.list</field>
        <field name="model">product.design.clipart</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [40, 40]}" string=" "/>
                <field name="name"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="product_design_clipart_view_form" model="ir.ui.view">
        <field name="name">product.design.clipart.form</field>
        <field name="model">product.design.clipart</field>
        <field name="arch" type="xml">
            <form string="Clipart">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Star"/></h1>
                    </div>
                    <group>
                        <field name="category_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_design_clipart_action" model="ir.actions.act_window">
        <field name="name">Clipart</field>
        <field name="res_model">product.design.clipart</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add clipart</p>
            <p>Logos, icons and illustrations customers can add to their design
               in one click. PNG with a transparent background or SVG work best.</p>
        </field>
    </record>

    <record id="product_design_clipart_category_view_list" model="ir.ui.view">
        <field name="name">product.design.clipart.category.list</field>
        <field name="model">product.design.clipart.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="product_design_clipart_category_action" model="ir.actions.act_window">
        <field name="name">Clipart Categories</field>
        <field name="res_model">product.design.clipart.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
