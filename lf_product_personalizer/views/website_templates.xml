<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Product page
         ================================================================ -->
    <template id="product_personalization_button" inherit_id="website_sale.product"
              name="Product Personalization Button">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="before">
            <t t-set="lf_product" t-value="product.sudo()"/>
            <t t-set="lf_personalizable" t-value="lf_product._lf_is_personalizable()"/>
        </xpath>
        <xpath expr="//a[@id='add_to_cart']" position="before">
            <a t-if="lf_personalizable"
               role="button" id="customize_product_button"
               t-attf-class="btn {{'btn-primary' if lf_product.personalization_required else 'btn-outline-primary'}} o_lf_personalize_btn flex-grow-1"
               t-att-href="'/shop/personalize/%s' % product.id">
                <i class="fa fa-paint-brush me-2" role="img" aria-hidden="true"/>Personalize
            </a>
        </xpath>
        <xpath expr="//a[@id='add_to_cart']" position="attributes">
            <attribute name="t-attf-class" add="{{'d-none' if lf_personalizable and lf_product.personalization_required else ''}}" separator=" "/>
        </xpath>
    </template>

    <!-- ================================================================
         Design editor page
         ================================================================ -->
    <template id="product_personalization_page" name="Product Personalization Page">
        <t t-call="website.layout">
            <t t-set="additional_title">Personalize <t t-out="product.name"/></t>
            <div id="wrap" class="o_lf_personalizer"
                 t-att-data-product-id="product.id"
                 t-att-data-variant-id="variant_id"
                 t-att-data-line-id="line.id if line else ''"
                 t-att-data-design-id="saved_design.id if saved_design else ''"
                 t-att-data-access-token="access_token or ''"
                 t-att-data-revision="'1' if revision else ''"
                 t-att-data-quantity="quantity or 1">

                <!-- Top bar -->
                <div class="o_lf_topbar border-bottom bg-white">
                    <div class="container-fluid d-flex flex-wrap align-items-center gap-2 py-2">
                        <a t-att-href="back_url or product.website_url" class="btn btn-link px-1"
                           title="Back to product" aria-label="Back to product">
                            <i class="fa fa-arrow-left" role="img" aria-hidden="true"/>
                        </a>
                        <div class="me-auto min-w-0">
                            <div class="h6 mb-0 text-truncate" t-out="product.name"/>
                            <small class="text-muted o_lf_price_info"/>
                        </div>
                        <div class="btn-group" role="group" aria-label="History">
                            <button type="button" class="btn btn-light o_lf_undo" title="Undo (Ctrl+Z)"
                                    aria-label="Undo" disabled="disabled">
                                <i class="fa fa-undo" role="img" aria-hidden="true"/>
                            </button>
                            <button type="button" class="btn btn-light o_lf_redo" title="Redo (Ctrl+Y)"
                                    aria-label="Redo" disabled="disabled">
                                <i class="fa fa-repeat" role="img" aria-hidden="true"/>
                            </button>
                        </div>
                        <div class="dropdown">
                            <button type="button" class="btn btn-light dropdown-toggle"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa fa-ellipsis-h" role="img" aria-hidden="true"/>
                                <span class="d-none d-md-inline ms-1">More</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><button type="button" class="dropdown-item o_lf_preview">
                                    <i class="fa fa-eye fa-fw me-1"/>Preview</button></li>
                                <li><button type="button" class="dropdown-item o_lf_download">
                                    <i class="fa fa-download fa-fw me-1"/>Download image</button></li>
                                <li><button type="button" class="dropdown-item o_lf_save_design">
                                    <i class="fa fa-heart-o fa-fw me-1"/>Save to my account</button></li>
                                <li><button type="button" class="dropdown-item o_lf_share d-none">
                                    <i class="fa fa-share-alt fa-fw me-1"/>Copy share link</button></li>
                                <li class="o_lf_manager_only d-none"><hr class="dropdown-divider"/></li>
                                <li class="o_lf_manager_only d-none">
                                    <button type="button" class="dropdown-item o_lf_save_preset">
                                        <i class="fa fa-star-o fa-fw me-1"/>Save as template</button></li>
                                <li><hr class="dropdown-divider"/></li>
                                <li><button type="button" class="dropdown-item text-danger o_lf_clear">
                                    <i class="fa fa-trash-o fa-fw me-1"/>Clear this side</button></li>
                            </ul>
                        </div>
                        <div t-if="not revision" class="input-group o_lf_qty">
                            <span class="input-group-text">Qty</span>
                            <input type="number" class="form-control o_lf_quantity" min="1" step="1"
                                   t-att-value="quantity or 1" aria-label="Quantity"/>
                        </div>
                        <button type="button" class="btn btn-primary o_lf_add_to_cart">
                            <i class="fa fa-shopping-cart me-1" role="img" aria-hidden="true"/>
                            <t t-if="revision">Send for review</t>
                            <t t-elif="line">Update cart</t>
                            <t t-else="">Add to cart</t>
                        </button>
                    </div>
                </div>

                <div t-if="revision" class="alert alert-warning rounded-0 mb-0 o_lf_revision_notice" role="alert">
                    <strong>Changes needed.</strong>
                    Update your design, then click <b>Send for review</b>. Your order and its price do not change.
                    <ul class="mb-0 mt-1">
                        <li t-foreach="rejected" t-as="design">
                            <b t-out="design.design_type"/>: <t t-out="design.approval_note"/>
                        </li>
                    </ul>
                </div>
                <div class="o_lf_body">
                    <!-- Canvas -->
                    <main class="o_lf_stage">
                        <div class="o_lf_areas nav nav-pills justify-content-center flex-nowrap"
                             role="tablist" aria-label="Areas"/>
                        <div class="o_lf_canvas_wrapper">
                            <div class="o_lf_loading text-muted">
                                <i class="fa fa-circle-o-notch fa-spin me-2" role="img" aria-hidden="true"/>
                                Loading the editor...
                            </div>
                        </div>
                        <div class="o_lf_hint small text-muted text-center d-none">
                            Your design must stay inside the dashed zone.
                        </div>
                    </main>

                    <!-- Tools -->
                    <aside class="o_lf_sidebar">
                        <nav class="o_lf_tools" aria-label="Design tools">
                            <button type="button" class="o_lf_tool d-none" data-panel="templates">
                                <i class="fa fa-magic" role="img" aria-hidden="true"/><span>Templates</span>
                            </button>
                            <button type="button" class="o_lf_tool" data-panel="text" data-tool="text">
                                <i class="fa fa-font" role="img" aria-hidden="true"/><span>Text</span>
                            </button>
                            <button type="button" class="o_lf_tool" data-panel="image" data-tool="image">
                                <i class="fa fa-upload" role="img" aria-hidden="true"/><span>Upload</span>
                            </button>
                            <button type="button" class="o_lf_tool" data-panel="clipart" data-tool="clipart">
                                <i class="fa fa-smile-o" role="img" aria-hidden="true"/><span>Clipart</span>
                            </button>
                            <button type="button" class="o_lf_tool" data-panel="shape" data-tool="shape">
                                <i class="fa fa-star-o" role="img" aria-hidden="true"/><span>Shapes</span>
                            </button>
                            <button type="button" class="o_lf_tool" data-panel="layers">
                                <i class="fa fa-clone" role="img" aria-hidden="true"/><span>Layers</span>
                            </button>
                            <button type="button" class="o_lf_tool d-none" data-panel="variant">
                                <i class="fa fa-th-large" role="img" aria-hidden="true"/><span>Variant</span>
                            </button>
                        </nav>

                        <div class="o_lf_panels">
                            <!-- Templates -->
                            <section class="o_lf_panel" data-panel="templates">
                                <h6>Start from a design</h6>
                                <div class="o_lf_presets row g-2"/>
                            </section>

                            <!-- Text -->
                            <section class="o_lf_panel" data-panel="text">
                                <h6>Add text</h6>
                                <div class="input-group mb-3">
                                    <input type="text" class="form-control o_lf_text_input"
                                           placeholder="Type your text" aria-label="Text"/>
                                    <button type="button" class="btn btn-primary o_lf_add_text">
                                        <i class="fa fa-plus" role="img" aria-hidden="true"/>
                                        <span class="ms-1">Add</span>
                                    </button>
                                </div>
                                <div class="o_lf_text_controls d-none">
                                    <label class="form-label small mb-1">Edit selected text</label>
                                    <input type="text" class="form-control mb-2 o_lf_text_edit"
                                           aria-label="Selected text"/>
                                    <label class="form-label small mb-1">Font</label>
                                    <select class="form-select mb-2 o_lf_font" aria-label="Font"/>
                                    <div class="d-flex gap-2 mb-2">
                                        <input type="number" class="form-control o_lf_font_size"
                                               min="8" max="300" aria-label="Font size"/>
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-outline-secondary o_lf_style"
                                                    data-style="bold" title="Bold" aria-label="Bold">
                                                <i class="fa fa-bold" role="img" aria-hidden="true"/></button>
                                            <button type="button" class="btn btn-outline-secondary o_lf_style"
                                                    data-style="italic" title="Italic" aria-label="Italic">
                                                <i class="fa fa-italic" role="img" aria-hidden="true"/></button>
                                            <button type="button" class="btn btn-outline-secondary o_lf_style"
                                                    data-style="underline" title="Underline" aria-label="Underline">
                                                <i class="fa fa-underline" role="img" aria-hidden="true"/></button>
                                        </div>
                                    </div>
                                    <div class="btn-group w-100 mb-2" role="group" aria-label="Alignment">
                                        <button type="button" class="btn btn-outline-secondary o_lf_align" data-align="left"
                                                title="Align left" aria-label="Align left">
                                            <i class="fa fa-align-left" role="img" aria-hidden="true"/></button>
                                        <button type="button" class="btn btn-outline-secondary o_lf_align" data-align="center"
                                                title="Center" aria-label="Center">
                                            <i class="fa fa-align-center" role="img" aria-hidden="true"/></button>
                                        <button type="button" class="btn btn-outline-secondary o_lf_align" data-align="right"
                                                title="Align right" aria-label="Align right">
                                            <i class="fa fa-align-right" role="img" aria-hidden="true"/></button>
                                    </div>
                                    <label class="form-label small mb-1">Colour</label>
                                    <div class="o_lf_palette" data-target="text"/>
                                </div>
                            </section>

                            <!-- Upload -->
                            <section class="o_lf_panel" data-panel="image">
                                <h6>Upload an image</h6>
                                <label class="o_lf_dropzone">
                                    <i class="fa fa-cloud-upload fa-2x" role="img" aria-hidden="true"/>
                                    <span>Choose a file or drop it here</span>
                                    <small class="text-muted">PNG, JPG, WebP</small>
                                    <input type="file" class="o_lf_upload visually-hidden"
                                           accept="image/png,image/jpeg,image/webp" multiple="multiple"/>
                                </label>
                                <div class="o_lf_image_controls d-none mt-3">
                                    <div class="btn-group w-100 mb-3" role="group">
                                        <button type="button" class="btn btn-outline-secondary o_lf_image_op" data-op="flipX">
                                            <i class="fa fa-arrows-h me-1"/>Flip</button>
                                        <button type="button" class="btn btn-outline-secondary o_lf_image_op" data-op="flipY">
                                            <i class="fa fa-arrows-v me-1"/>Flip</button>
                                        <button type="button" class="btn btn-outline-secondary o_lf_image_op" data-op="crop">
                                            <i class="fa fa-crop me-1"/><span class="o_lf_crop_label">Crop</span></button>
                                    </div>
                                    <label class="form-label small mb-1">Brightness</label>
                                    <input type="range" class="form-range o_lf_image_filter" data-op="brightness"
                                           min="-1" max="1" step="0.05" value="0"/>
                                    <label class="form-label small mb-1">Contrast</label>
                                    <input type="range" class="form-range o_lf_image_filter" data-op="contrast"
                                           min="-1" max="1" step="0.05" value="0"/>
                                    <label class="form-label small mb-1">Saturation</label>
                                    <input type="range" class="form-range o_lf_image_filter" data-op="saturation"
                                           min="-1" max="1" step="0.05" value="0"/>
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary o_lf_image_op"
                                                data-op="grayscale">Black &amp; white</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary o_lf_image_op"
                                                data-op="sepia">Sepia</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger o_lf_image_op"
                                                data-op="resetFilters">Reset</button>
                                    </div>
                                </div>
                            </section>

                            <!-- Clipart -->
                            <section class="o_lf_panel" data-panel="clipart">
                                <h6>Clipart</h6>
                                <input type="search" class="form-control mb-2 o_lf_clipart_search"
                                       placeholder="Search..." aria-label="Search clipart"/>
                                <div class="o_lf_cliparts row g-2"/>
                            </section>

                            <!-- Shapes -->
                            <section class="o_lf_panel" data-panel="shape">
                                <h6>Shapes</h6>
                                <div class="o_lf_shapes row g-2 mb-3"/>
                                <div class="o_lf_shape_controls d-none">
                                    <label class="form-label small mb-1">Fill</label>
                                    <div class="o_lf_palette mb-2" data-target="fill"/>
                                    <label class="form-label small mb-1">Border</label>
                                    <div class="o_lf_palette mb-2" data-target="stroke"/>
                                    <label class="form-label small mb-1">Border width</label>
                                    <input type="range" class="form-range o_lf_stroke_width" min="0" max="20" step="1"/>
                                </div>
                            </section>

                            <!-- Layers -->
                            <section class="o_lf_panel" data-panel="layers">
                                <h6>Layers</h6>
                                <div class="o_lf_layers list-group"/>
                                <p class="o_lf_layers_empty text-muted small">Nothing on this side yet.</p>
                            </section>

                            <!-- Variants -->
                            <section class="o_lf_panel" data-panel="variant">
                                <h6>Choose a variant</h6>
                                <div class="o_lf_variants row g-2"/>
                            </section>
                        </div>
                    </aside>
                </div>
            </div>
        </t>
    </template>
</odoo>
