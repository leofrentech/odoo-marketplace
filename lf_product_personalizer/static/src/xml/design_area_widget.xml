<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lf_product_personalizer.DesignAreaWidget">
        <div class="o_design_area_widget w-100">
            <div t-if="!hasImage" class="alert alert-warning mb-0" role="alert">
                <i class="fa fa-exclamation-triangle me-1"/>Upload a mockup image first.
            </div>
            <t t-else="">
                <p class="text-muted small mb-2">
                    Drag and resize the blue rectangle: customers can only design inside it.
                </p>
                <div t-ref="container" class="w-100" style="max-width: 800px;">
                    <canvas t-ref="canvas" class="border rounded"/>
                </div>
            </t>
        </div>
    </t>
</templates>
