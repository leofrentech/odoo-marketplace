<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="shared_view_state_view_list" model="ir.ui.view">
        <field name="name">shared.view.state.view.list</field>
        <field name="model">shared.view.state</field>
        <field name="arch" type="xml">
            <list>
                <field name="action_id" />
                <field name="model" />
                <field name="domain" />
                <field name="context" />
                <field name="owner_id" />
                <button type="object" name="action_copy_url" string="Copy URL" />
            </list>
        </field>
    </record>

    <record id="shared_view_state_view_form" model="ir.ui.view">
        <field name="name">shared.view.state.view.form</field>
        <field name="model">shared.view.state</field>
        <field name="arch" type="xml">
            <form>
                <shet>
                    <group>
                        <group>
                            <field name="owner_id" widget="selection" />
                            <field name="model" />
                            <field name="action_id" widget="selection" />
                            <field name="view_mode" />
                        </group>
                        <group>
                            <field name="domain" />
                            <field name="context" />
                            <field name="sort" />
                        </group>
                    </group>
                </shet>
            </form>
        </field>
    </record>

    <record id="shared_view_state_action_load" model="ir.actions.act_window">
        <field name="name">Shared views</field>
        <field name="res_model">shared.view.state</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="shared_view_sate_menu_show" name="Shared Views"
        action="shared_view_state_action_load" />
</odoo>