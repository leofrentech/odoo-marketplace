<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="share_view.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_actions')]" position="after">
            <button type="button" class="btn btn-secondary"
                    t-on-click="shareCurrentView">
                Share View
            </button>
        </xpath>
    </t>
</templates>