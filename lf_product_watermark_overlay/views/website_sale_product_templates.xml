<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="website_sale_products_item_watermark" inherit_id="website_sale.products_item">
        <!-- Primary image -->
        <xpath expr="//span[@t-field='primary_image_holder.image_1920']" position="replace">
            <t t-if="request.env['ir.config_parameter'].sudo().get_param('lf_product_watermark_overlay.enable_website')">
                <span
                    t-field="primary_image_holder.image_1920"
                    t-options="{'widget': 'image', 'preview_image': 'watermarked_image_1024', 'class': 'oe_product_image_img h-100 w-100'}"
                    class="oe_product_image_img_wrapper oe_product_image_img_wrapper_primary d-flex h-100 justify-content-center align-items-center"
                />
            </t>
            <t t-else="">
                <span
                    t-field="primary_image_holder.image_1920"
                    t-options="{'widget': 'image', 'preview_image': 'image_1024', 'class': 'oe_product_image_img h-100 w-100'}"
                    class="oe_product_image_img_wrapper oe_product_image_img_wrapper_primary d-flex h-100 justify-content-center align-items-center"
                />
            </t>
        </xpath>

        <!-- Secondary image -->
        <xpath expr="//span[@t-field='secondary_image_holder.image_1920']" position="replace">
            <t t-if="secondary_image_holder">
                <t t-if="request.env['ir.config_parameter'].sudo().get_param('lf_product_watermark_overlay.enable_website')">
                    <span
                        t-field="secondary_image_holder.image_1920"
                        t-options="{'widget': 'image', 'preview_image': 'watermarked_image_1024', 'class': 'oe_product_image_img_secondary h-100 w-100'}"
                        class="oe_product_image_img_wrapper oe_product_image_img_wrapper_secondary h-100 justify-content-center align-items-center"
                    />
                </t>
                <t t-else="">
                    <span
                        t-field="secondary_image_holder.image_1920"
                        t-options="{'widget': 'image', 'preview_image': 'image_1024', 'class': 'oe_product_image_img_secondary h-100 w-100'}"
                        class="oe_product_image_img_wrapper oe_product_image_img_wrapper_secondary h-100 justify-content-center align-items-center"
                    />
                </t>
            </t>
        </xpath>
    </template>

    <!-- Inherit dynamic product snippet -->
    <template id="dynamic_filter_template_product_product_products_item_watermark"
        inherit_id="website_sale.dynamic_filter_template_product_product_products_item" >
        <xpath expr="//span[contains(@t-attf-style, 'background-image')]" position="replace">
            <t t-set="website_watermark_enabled"
               t-value="request.env['ir.config_parameter'].sudo().get_param('lf_product_watermark_overlay.enable_website')"/>

            <span
                class="oe_product_image_img h-100 w-100"
                t-attf-style="
                    background-image: url(
                        {{ website_watermark_enabled
                            and '/web/image/product.template/%s/watermarked_image_512' % product_template_id
                            or data['image_512']
                        }}
                    );"/>
        </xpath>
    </template>

    <!-- Inherit product image template -->
    <template id="shop_product_image_inherit_watermark" inherit_id="website_sale.shop_product_image">
        <xpath expr="//span[@t-field='product_image.image_1920']" position="attributes">
            <attribute name="t-options">{
                'widget': 'image',
                'preview_image': request.env['ir.config_parameter'].sudo().get_param('lf_product_watermark_overlay.enable_website')
                     and 'watermarked_image_1024' or 'image_1024',
                'class': 'oe_unmovable product_detail_img h-100 w-100',
                'alt-field': 'name',
                'zoom': product_image.can_image_1024_be_zoomed and 'image_1920'
            }</attribute>
        </xpath>

        <xpath expr="//div[@t-field='product_image.image_1920']" position="attributes">
            <attribute name="t-options">{
                'widget': 'image',
                'preview_image': request.env['ir.config_parameter'].sudo().get_param('lf_product_watermark_overlay.enable_website')
                     and 'watermarked_image_1024' or 'image_1024',
                'class': 'oe_unmovable product_detail_img w-100 h-100',
                'alt-field': 'name',
                'zoom': product_image.can_image_1024_be_zoomed and 'image_1920'
            }</attribute>
        </xpath>
    </template>
</odoo>
