<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.lf_product_watermark_overlay</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(lf_product_watermark_overlay.product_template_watermark_action)d"
                    type="action" class="oe_stat_button" icon="fa-magic"
                    string="Add/Update Watermark"
                    invisible="not has_watermark and (not is_watermark_eligible or not watermark_globally_enabled)"/>
            </xpath>
            <xpath expr="//group[@name='group_standard_price']/field[@name='company_id']" position="before">
                <field name="watermark_globally_enabled" invisible="1"/>
                <field name="has_watermark" invisible="1"/>
                <field name="is_watermark_eligible" invisible="not watermark_globally_enabled"/>
            </xpath>
        </field>
    </record>
</odoo>
