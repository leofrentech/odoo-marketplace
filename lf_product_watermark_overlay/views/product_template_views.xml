<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.product.watermark.overlay</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="watermark_config" string="Watermark Configuration">
                    <group colspan="4">
                        <field name="is_watermark_override" />
                        <field name="watermarked_image_1920" widget="image" class="oe_avatar"/>
                    </group>
                    <group string="Watermark Settings" invisible="not is_watermark_override">
                        <group>
                            <field name="watermark_type" required="is_watermark_override" />
                            <field name="watermark_position" required="is_watermark_override" />
                            <field name="watermark_opacity" required="is_watermark_override" />
                        </group>
                        <group>
                            <field name="watermark_logo" required="watermark_type == 'image'" invisible="watermark_type != 'image'" />
                            <field name="watermark_text" required="watermark_type == 'text'" invisible="watermark_type != 'text'" />
                            <field name="watermark_font" required="watermark_type == 'text'" invisible="watermark_type != 'text'" />
                            <field name="watermark_color" widget="color" required="watermark_type == 'text'" invisible="watermark_type != 'text'" />
                            <field name="watermark_size" required="watermark_type == 'text'" invisible="watermark_type != 'text'" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>