<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_regenerate_watermarked_images" model="ir.cron">
        <field name="name">Product Watermark Overlay: Regenerate Watermarked Images</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_regenerate_watermarked_images()</field>
        <!-- Normally only runs when triggered on-demand from the
             "Regenerate All Images" settings button; the weekly interval
             is just a safety net in case a trigger is ever missed. -->
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active">True</field>
    </record>
</odoo>
