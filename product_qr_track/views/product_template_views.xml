<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view.inherit.qr_track</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[@name='action_open_documents']"
                position="after">
                <button type="object" name="action_open_qr_visits" class="oe_stat_button"
                    invisible="qr_visit_count &lt; 1"
                    icon="fa-user">
                    <field name="qr_visit_count" string="QR Visits" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>