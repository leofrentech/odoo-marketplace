<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Users see the opens of emails they sent or of documents they are responsible for -->
    <record id="email_tracker_recipient_rule_user" model="ir.rule">
        <field name="name">Email Opens: own emails and documents</field>
        <field name="model_id" ref="model_email_tracker_recipient"/>
        <field name="domain_force">['|', ('author_id', '=', user.partner_id.id), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="email_tracker_recipient_rule_system" model="ir.rule">
        <field name="name">Email Opens: administrators see all</field>
        <field name="model_id" ref="model_email_tracker_recipient"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
