<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="email_tracker_recipient_view_list" model="ir.ui.view">
        <field name="name">email.tracker.recipient.view.list</field>
        <field name="model">email.tracker.recipient</field>
        <field name="arch" type="xml">
            <list string="Email Opens" create="0" edit="0" delete="0"
                  decoration-muted="not open_count" decoration-success="open_count">
                <field name="sent_date"/>
                <field name="subject"/>
                <field name="record_name"/>
                <field name="recipient_label" string="Recipient"/>
                <field name="partner_id" optional="hide"/>
                <field name="email" optional="hide"/>
                <field name="author_name" string="Sent By" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="open_count"/>
                <field name="first_open_date" optional="show"/>
                <field name="last_open_date" optional="hide"/>
                <button name="action_open_document" type="object" icon="fa-external-link" title="Open Document"/>
            </list>
        </field>
    </record>

    <record id="email_tracker_recipient_view_form" model="ir.ui.view">
        <field name="name">email.tracker.recipient.view.form</field>
        <field name="model">email.tracker.recipient</field>
        <field name="arch" type="xml">
            <form string="Email Open" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_document" type="object" string="Open Document" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="subject"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="record_name"/>
                            <field name="model" groups="base.group_no_one"/>
                            <field name="res_id" groups="base.group_no_one"/>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="author_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="sent_date"/>
                            <field name="open_count"/>
                            <field name="first_open_date"/>
                            <field name="last_open_date"/>
                            <field name="mail_message_id" groups="base.group_no_one"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="email_tracker_recipient_view_search" model="ir.ui.view">
        <field name="name">email.tracker.recipient.view.search</field>
        <field name="model">email.tracker.recipient</field>
        <field name="arch" type="xml">
            <search string="Email Opens">
                <field name="subject"/>
                <field name="record_name"/>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="author_id"/>
                <filter string="Sent by Me" name="sent_by_me" domain="[('author_id.user_ids', 'in', [uid])]"/>
                <filter string="My Documents" name="my_documents" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Opened" name="opened" domain="[('open_count', '>', 0)]"/>
                <filter string="Not Opened" name="not_opened" domain="[('open_count', '=', 0)]"/>
                <separator/>
                <filter string="Sent On" name="sent_date" date="sent_date"/>
                <group>
                    <filter string="Recipient" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Sent By" name="group_author" context="{'group_by': 'author_id'}"/>
                    <filter string="Document Type" name="group_model" context="{'group_by': 'model'}"/>
                    <filter string="Sent On" name="group_sent_date" context="{'group_by': 'sent_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="email_tracker_recipient_action" model="ir.actions.act_window">
        <field name="name">Email Opens</field>
        <field name="res_model">email.tracker.recipient</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tracked email yet</p>
            <p>Emails sent to customers from a document chatter are listed here with their opens.</p>
        </field>
    </record>

    <menuitem id="email_tracker_recipient_menu"
              action="email_tracker_recipient_action"
              parent="mail.menu_root_discuss"
              sequence="2"/>
</odoo>
