<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_message_view_form" model="ir.ui.view">
        <field name="name">mail.message.view.form.inherit.email_tracker</field>
        <field name="model">mail.message</field>
        <field name="inherit_id" ref="mail.mail_message_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Email Opens" name="email_tracker" invisible="not email_tracker_recipient_ids">
                    <field name="email_tracker_recipient_ids">
                        <list>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="open_count"/>
                            <field name="first_open_date"/>
                            <field name="last_open_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <field name="parent_id" position="after">
                <field name="email_open_origin_message_id" invisible="not email_open_origin_message_id"/>
            </field>
        </field>
    </record>
</odoo>
