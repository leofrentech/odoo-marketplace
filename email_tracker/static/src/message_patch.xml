<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- "Opened" badge next to the delivery status of sent emails, on any chatter -->
    <t t-inherit="mail.Message.notification" t-inherit-mode="extension">
        <xpath expr="." position="inside">
            <div t-if="message.originThread?.eq(props.thread) and message.email_tracker_recipient_ids.length" class="mx-1">
                <span class="o-email-tracker-badge cursor-pointer small text-nowrap"
                      t-att-class="message.emailTrackerOpenedCount ? 'text-success' : 'text-muted opacity-75 opacity-100-hover'"
                      role="button" tabindex="0" t-att-title="emailTrackerLabel"
                      t-on-click="onClickEmailTracker">
                    <i class="fa" t-att-class="message.emailTrackerOpenedCount ? 'fa-eye' : 'fa-eye-slash'" role="img"/>
                    <span class="ms-1" t-esc="emailTrackerLabel"/>
                </span>
            </div>
        </xpath>
    </t>

</templates>
